#!/usr/bin/env bash
######################################################################
#
# update.sh
#
# Update the scripts in, by default, /tools/AGRreleases/yocto/pmr.
#
######################################################################

# Export everything
set -a

# Version
VERSION=__VERSION__

# Name
SCRIPT_NAME=$(basename "${0}")

# Script directory
SCRIPT_DIR=`dirname $0`
pushd ${SCRIPT_DIR} >/dev/null 2>&1
SCRIPT_DIR=$(pwd)
popd >/dev/null 2>&1

#############
# Functions #
#############

function getdv {
    if [ -f /etc/os-release ]; then
	# freedesktop.org and systemd
	. /etc/os-release
	DISTRO=$NAME
	VER=$VERSION_ID
    elif type lsb_release >/dev/null 2>&1; then
	# linuxbase.org
	DISTRO=$(lsb_release -si)
	VER=$(lsb_release -sr)
    else
	# Fall back to uname, e.g. "Linux <version>", also works for BSD, etc.
	DISTRO=$(uname -s)
	VER=$(uname -r)
    fi

    echo "$DISTRO:$VER"
}

function script_info {
    echo "--> ${SCRIPT_NAME} version is ${VERSION}"
    echo "--> running on $(getdv)"
}

############
# Defaults #
############

INSTALL="/tools/AGRreleases/yocto/pmr/scripts"
KEEP_TEMP="false"
QUIET="false"

######################################################################
# usage_
#
# Display usage and exit with the given code.

function usage {
    cat << EOF
${SCRIPT_NAME} [-h|--help] [-i|--install] [-k|--keep] [-q|--quiet] [-v|--version]
  -h : Display this wonderful help screen.
  -i : Install location.
  -k : Keep temporary output instead of deleting it.
  -q : Be quiet.
  -v : Display the version.
EOF
    exit $1
}

##################################
# Parse the command line options #
##################################

ARGS=$(getopt -a -o hikv --long help,install,keep,version -- "$@")

if [[ $? -gt 0 ]]
then
    usage 1
fi

eval set -- ${ARGS}
while :
do
    case $1 in
        -h | --help) usage 0 ; shift ;;
	-i | --install) INSTALL="$2" ; shift ;;
	-k | --keep) KEEP_TEMP="true" ; shift ;;
	-q | --quiet) QUIET="true" ; shift ;;
	-v | --version) script_info ; exit 0 ;;
	--) shift ; break ;;
        *) usage 1 ;;
    esac
done

# $@ has all the options after --

##########################################
# Capture stdout and stdin in a log file #
##########################################

exec 3<&1
exec 4<&2

# Create a log file and redirect. 
TEMP=$(mktemp -d /tmp/${SCRIPT_NAME}.XXXXXXXXXXXX)
LOG=$TEMP/log
PIPE=$TEMP/pipe

if [ "$KEEP_TEMP" = "true" ]
then
    echo "--> Saving temporary files in ${TEMP}"
else
    trap "rm -rf $TEMP" EXIT
fi

mknod $PIPE p
tee <$PIPE $LOG &
exec 1>&-
exec 1>$PIPE
exec 2>&-
exec 2>$PIPE

#######################
# Do something useful #
#######################

if [ "$QUIET" != "true" ]
then
    script_info
fi

# Make sure $INSTALL exists and is writeable.
if [ ! -w "$INSTALL" ]
then
    echo "\"$INSTALL\" must exist and be writable!"
    exit 1
fi

# Update 'austinify' from the lab server.
# NOTE: The point of using the current version on the lab server is
# that it should make the user experience less shocking -- it should
# match the current experience.

# Get the active server.
ACTIVE=$(ssh aus-labsrv3 /export/scripts/active.sh)
echo "--> Copying ausinify from $ACTIVE to $INSTALL"
rm -rf "$INSTALL/austinify*"
scp -q $ACTIVE:/export/scripts/austinify.sh "$INSTALL" ||
    echo "--> Unable to copy austinify.sh! "
scp -r $ACTIVE:/export/scripts/austinify "$INSTALL" ||
    echo "--> Unable to copy austinify! "

# Update image.sh from /workspace/sw/jjacques/projects/pmr/scripts
echo "--> Copy image.sh from John's PMR script to $INSTALL"
rm -f "$INSTALL/image.sh"
cp /workspace/sw/jjacques/projects/pmr/scripts/image.sh "$INSTALL" ||
    echo "--> Unable to copy image.sh! "

# done...
exit 0

#############################
# Restore stdout and stderr #
#############################

rm -f $PIPE
exec 1<&3 3<&-
exec 2<&4 4<&-

##############
# That's all #
##############

exit 0
