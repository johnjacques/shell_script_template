#!/usr/bin/env bash
######################################################################
#
# update_wic.sh
#
# Copy the given kernel and modules to the given wic image.
#
######################################################################

# Export everything
set -a

# Version
VERSION=__VERSION__

# Name
SCRIPT_NAME=$(basename "${0}")

# Script directory
SCRIPT_DIR=`dirname $0`
pushd ${SCRIPT_DIR} >/dev/null 2>&1
SCRIPT_DIR=$(pwd)
popd >/dev/null 2>&1

#############
# Functions #
#############

function getdv {
    if [ -f /etc/os-release ]; then
	# freedesktop.org and systemd
	. /etc/os-release
	DISTRO=$NAME
	VER=$VERSION_ID
    elif type lsb_release >/dev/null 2>&1; then
	# linuxbase.org
	DISTRO=$(lsb_release -si)
	VER=$(lsb_release -sr)
    else
	# Fall back to uname, e.g. "Linux <version>", also works for BSD, etc.
	DISTRO=$(uname -s)
	VER=$(uname -r)
    fi

    echo "$DISTRO:$VER"
}

function script_info {
    echo "--> ${SCRIPT_NAME} version is ${VERSION}"
    echo "--> running on $(getdv)"
}

############
# Defaults #
############

KEEP_TEMP="false"
LINUX="$(pwd)/arch/x86/boot/bzImage"
MODULES="$(pwd)/$(ls -d target_modules/lib/modules/*)"
WIC="diskimage.wic"

######################################################################
# usage_
#
# Display usage and exit with the given code.

function usage {
    cat << EOF
${SCRIPT_NAME} [-h|--help] [-k|--keep] [-l|--linux] [-m|--modules] [-v|--version] [-w|--wic]
  -h : Display this wonderful help screen.
  -k : Keep temporary output instead of deleting it.
  -l : The Linux kernel to copy to the wic. [$LINUX]
  -m : The Linux modules to copy to the wic. [$MODULES]
  -v : Display the version.
  -w : The wic image to update. [$WIC]
EOF
    exit $1
}

##################################
# Parse the command line options #
##################################

ARGS=$(getopt -a -o hkl:m:vw: --long help,keep,linux:,modules:,version,wic: -- "$@")

if [[ $? -gt 0 ]]
then
    usage 1
fi

eval set -- ${ARGS}
while :
do
    case $1 in
        -h | --help) usage 0 ; shift ;;
	-k | --keep) KEEP_TEMP="true" ; shift ;;
	-l | --linux) LINUX="${OPTARG}" ; shift ;;
	-m | --modules) MODULES="${OPTARG}" ; shift ;;
	-v | --version) script_info ; exit 0 ;;
	-w | --wic) WIC="${OPTARGS}" ; shift ;;
	--) shift ; break ;;
        *) usage 1 ;;
    esac
done

# $@ has all the options after --

##########################################
# Capture stdout and stdin in a log file #
##########################################

exec 3<&1
exec 4<&2

# Create a log file and redirect. 
TEMP=$(mktemp -d /tmp/${SCRIPT_NAME}.XXXXXXXXXXXX)
LOG=$TEMP/log
PIPE=$TEMP/pipe

if [ "$KEEP_TEMP" = "true" ]
then
    echo "--> Saving temporary files in ${TEMP}"
else
    trap "rm -rf $TEMP" EXIT
fi

mknod $PIPE p
tee <$PIPE $LOG &
exec 1>&-
exec 1>$PIPE
exec 2>&-
exec 2>$PIPE

#######################
# Do something useful #
#######################

if [[ ! -r $LINUX || ! -d $MODULES || ! -w $WIC ]]
then
    echo "Looks like you need help..."
    usage 1
fi

echo "Adding $LINUX and $MODULES to $WIC"

mkdir -p $TEMP/boot $TEMP/root
chmod 777 $TEMP/boot $TEMP/root
LOOP=$(sudo losetup --find --show --partscan $WIC)
sudo mount ${LOOP}p1 $TEMP/boot
sudo mount ${LOOP}p2 $TEMP/root
sudo cp $LINUX $TEMP/boot/bzImage
sudo rm -rf $TEMP/root/lib/modules/*
sudo cp -r $MODULES $TEMP/root/lib/modules
sudo umount boot root
sudo losetup -d $LOOP

#############################
# Restore stdout and stderr #
#############################

rm -f $PIPE
exec 1<&3 3<&-
exec 2<&4 4<&-

##############
# That's all #
##############

exit 0
